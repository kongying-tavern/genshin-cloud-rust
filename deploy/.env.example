# ============ 空荧酒馆后端线上部署配置模板 ============
# 复制为 .env 后按实际环境修改；所有值都会被 gcs-backend 容器读取。

# ---- 端口 ----
# 宿主机对外端口（映射到容器 80）。线上若走 nginx 反代，改 127.0.0.1:8101:80。
HOST_PORT=8101

# ---- 运行环境标识 ----
# /oauth/token 登录响应里 env 字段的取值（Java active profile 契约）。
# 未设置时默认 dev；正式生产环境请设为 prod。
# APP_ENV=dev

# ---- 数据库（必填）----
DB_HOST=ddns.minemc.top
DB_PORT=13070
DB_USERNAME=genshin_map
DB_PASSWORD=CHANGE_ME
DB_DATABASE=genshin_map
# Postgres schema（可选；默认 genshin_map）。必须是合法 SQL 标识符，
# 连接时通过 search_path 指向它。
# DB_SCHEMA=genshin_map

# ---- Redis（compose 内自动填 gcs-redis；改用外部 Redis 时覆盖）----
# REDIS_HOST=redis.example.com
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Redis 不可用时是否拒绝启动（true = 缺 Redis 直接失败，false = 降级运行）
REDIS_REQUIRED=false

# ---- MinIO 对象存储（必填；图片上传/图标）----
MINIO_BASE_URL=http://127.0.0.1:13900
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
# 接口回写（返回给客户端的文件 URL）使用的公网地址（可选）。
# 后端上传走上面的内部地址 MINIO_BASE_URL；若 CDN / 反代改写了公网地址，
# 用此变量指定（缺省时回退为 MINIO_BASE_URL）。
# MINIO_PUBLIC_BASE_URL=https://assets.example.com

# ---- JWT（必填）----
# HS256 签名密钥（>= 32 字节随机串；生成：openssl rand -base64 48）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# RSA 模式（可选）：配置 PEM 私钥后 token 改用 RS256，HS256 被禁用
# JWT_RSA_PRIVATE_KEY_PEM=
# JWT_RSA_VERIFY_KEYS=

# ---- 访问策略 ----
# true = 跳过 IP/UA 访问策略校验（开发期）；线上建议 false
SKIP_ACCESS_POLICY=false
# 反向代理场景：信任 X-Forwarded-For 等头（nginx 反代时必须 true）
# TRUST_PROXY_HEADERS=true

# ---- CORS（前端非同源访问时需要；逗号分隔白名单）----
# CORS_ALLOW_ORIGIN=https://map.example.com

# ---- 其他 ----
# 日志文件输出目录（可选）：设置后日志同时追加写入 <LOG_DIR>/genshin-cloud.log
# （stderr 输出保留）。Docker 部署建议挂载卷以持久化。
# LOG_DIR=/var/log/genshin-cloud
# 图标代理回源地址（前端图标经 /cdn 代理；保持默认即可）
ICON_PROXY_BASE=http://127.0.0.1:8101
# CDN 上游（/cdn 代理）
# CDN_UPSTREAM=https://v3.yuanshen.site
# 初始化管理员（首次启动自动创建）
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=CHANGE_ME

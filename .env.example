# Genshin Map Cloud (Rust) — Environment Variables
#
# Copy this file to `.env` and fill in your values.
# The `.env` file is gitignored and will NOT be committed.
# Full reference: see the "环境变量 / Environment Variables" section in README.md.

# ── PostgreSQL (required — startup fails if unreachable) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=genshin_map
DB_PASSWORD=<your-password>
DB_DATABASE=genshin_map
# Postgres schema for all tables (optional; default: genshin_map). Must be a
# plain SQL identifier — the connection `search_path` is set to it, and
# anything else falls back to the default with a warning.
# DB_SCHEMA=genshin_map

# ── HTTP Server ─────────────────────────────────────────────────────────────
# Port the backend binds on (default: 80).
PORT=8101

# ── App environment (optional) ───────────────────────────────────────────────
# Runtime environment identifier emitted as the `env` field of the /oauth/token
# login response (the Java active-profile contract). Defaults to `dev`; set
# `prod` in production deployments.
# APP_ENV=dev

# ── Logging (optional) ───────────────────────────────────────────────────────
# Directory for the log file. When set, logs are ALSO appended to
# <LOG_DIR>/genshin-cloud.log (stderr output stays on). The directory is
# created on startup when missing. Mount it as a volume in Docker to persist
# logs across restarts.
# LOG_DIR=/var/log/genshin-cloud

# ── Redis (optional — backend degrades gracefully if unreachable) ──────────
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Fail closed on Redis-dependent auth paths (token lookup / refresh / login
# failure counting) when Redis is unreachable. true = reject, false (default)
# = degrade to the JWT-signature-only / in-process fallback.
# REDIS_REQUIRED=false

# ── MinIO (optional — backend degrades gracefully if unreachable) ───────────
# MINIO_BASE_URL=http://localhost:9000
# MINIO_ACCESS_KEY=genshin_cloud
# MINIO_SECRET_KEY=genshin_cloud
# Public base for the URLs returned to clients (optional). The backend uploads
# through the internal MINIO_BASE_URL, but URLs in API responses are built
# from this address — set it when a CDN/reverse proxy rewrites the public
# address (defaults to MINIO_BASE_URL when unset).
# MINIO_PUBLIC_BASE_URL=https://assets.example.com

# ── CDN proxy (optional) ─────────────────────────────────────────────────────
# Upstream for the /cdn reverse proxy. Defaults to https://v3.yuanshen.site.
# Point it at a self-hosted CDN or an internal mirror if needed.
# CDN_UPSTREAM=https://v3.yuanshen.site
# Local pre-generated dadian config (bz2) served at /cdn/dadian-preview.json.bz2.
# When unset, the endpoint falls back to an empty dev config.
# CDN_DADIAN_CONFIG=/absolute/path/to/dadian-preview.json.bz2
# Base URL the tag_doc endpoint rewrites ddns.minemc.top icon URLs to, so they
# go through the /cdn/img-proxy instead of the dev MinIO host directly.
# Keep it pointing at this backend's public address (default: no rewriting).
# ICON_PROXY_BASE=http://127.0.0.1:8101

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins. When unset, no CORS headers
# are sent (cross-origin browser access is blocked; same-origin/Vite proxy
# still works).
# CORS_ALLOW_ORIGIN=https://map.example.com,https://admin.example.com

# ── JWT signing (required) ───────────────────────────────────────────────────
# REQUIRED: HMAC signing secret. There is no default — the process refuses to
# start without it (a predictable default would let anyone forge tokens).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret
# RSA private key PEM (PKCS#8 or PKCS#1). When set, tokens are signed with
# RS256 and /.well-known/jwks.json publishes the RSA public key. When unset,
# HS256 is used and the JWKS endpoint publishes an EMPTY key set (the HMAC
# secret is never disclosed). Tokens signed with either algorithm remain
# verifiable during a migration.
# Generate one with:  openssl genpkey -algorithm RSA -out jwt-rsa.pem -pkeyopt rsa_keygen_bits:2048
# JWT_RSA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# Historical RSA PUBLIC key PEMs for key rotation (optional, comma-separated;
# each entry may itself be a multi-line PEM). Old keys listed here keep
# verifying tokens after the signing key is rotated, and the JWKS publishes
# them (current key = "genshin-cloud-rsa-v1", historical = "v2", "v3", ...).
# Rotation: deploy step 1 with the NEW public key added here while still
# signing with the old key; then step 2 switch JWT_RSA_PRIVATE_KEY_PEM to
# the new key. Old tokens stay valid throughout.
# JWT_RSA_VERIFY_KEYS=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----,-----BEGIN PUBLIC KEY-----...
# Local/dev escape hatch: also accept HS256 tokens while RS256 signing is
# active. NEVER enable this in production (it reopens the HMAC downgrade).
# JWT_ACCEPT_HS256=false

# ── Access policy (optional) ────────────────────────────────────────────────
# Skip the IP / User-Agent access-policy checks (dev only; production keeps
# the default).
# SKIP_ACCESS_POLICY=false
# Trust X-Real-IP / X-Forwarded-For headers from the reverse proxy for
# access-policy checks and the action log. Enable ONLY behind a proxy that
# overwrites them (nginx), otherwise clients can spoof their IP.
# TRUST_PROXY_HEADERS=true

# ── init_db (dev bootstrap only — cargo run --bin init_db) ─────────────────
# Credentials of the auto-seeded dev admin account (defaults: admin/admin123).
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=admin123

# ── Dev / E2E ───────────────────────────────────────────────────────────────
# Absolute path to the Vue3 admin frontend project (required for `just dev`).
# Clone from: https://github.com/kongying-tavern/map_register_v3
E2E_VUE_FRONTEND=/absolute/path/to/map_register_v3
# Optional: a real backend account used by the e2e API assertions
# (scripts/e2e/run_tests.py). Without these, the authenticated API tests
# SKIP explicitly — a 401/403 is never treated as a pass.
# E2E_USERNAME=
# E2E_PASSWORD=
